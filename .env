# ------------------------------------------------------------------
#  Nani Executive Sales Dashboard — configuration
#  Copy this file to ".env" (same folder as app.py) and fill it in.
#  Do not commit the real .env to version control.
#
#  Precedence: real environment variables win, then this file, then
#  Streamlit secrets, then the built-in defaults in app.py.
# ------------------------------------------------------------------

# --- Connection -----------------------------------------------------
IIKO_BASE_URL=https://chinatown.iikoweb.ru
IIKO_LOGIN=Edgar
IIKO_PASSWORD=mkrtchyan1994mk
IIKO_API_KEY=da585561389549e1a86dd049281cd638

# --- Report ---------------------------------------------------------
IIKO_RESTAURANT=Nani
IIKO_PRESET_NAME=Sales intr

# The "Sales intr" preset id, captured from the portal's network traffic.
# It is part of the OLAP request PATH, so the report cannot be fetched
# without it. app.py falls back to this same value if left blank.
IIKO_PRESET_ID=7ac4dfd850327a8d89ab49c7000ba4d93a5263ce

# --- OLAP request payload -------------------------------------------
# Sent to POST /api/olap/fetch/{preset_id}/grouped-table, reproducing
# the portal's own request. Only the date window changes per call.
# Comma-separated for several venues, e.g. 45159,45160
IIKO_STORE_IDS=45159

# The portal sends includeNonBusinessPaymentTypes=false. That flag very
# likely EXCLUDES complimentary "(без оплаты)" checks, which would leave
# the Compliments tab empty. Set to 1 to pull them in.
IIKO_INCLUDE_NON_BUSINESS=0

# Voided transactions. The portal sends false.
IIKO_INCLUDE_VOID=0

# The captured payload requests ProductCostBase.Percent — COGS as a
# RATIO, not an amount — so absolute COGS is reconstructed as
# net x percent (gross x percent for zero-net rows such as compliments),
# which is only as precise as the rounded percentage. Set to 1 to also
# request ProductCostBase.ProductCost and get exact amounts; the exact
# captured payload stays as the fallback if the preset rejects it.
IIKO_ABSOLUTE_COGS=0

# --- Endpoint pinning -----------------------------------------------
# The verified route is:
#      POST /api/olap/fetch/{preset_id}/grouped-table
# app.py already uses it as the primary. Set this only to force a
# different path and skip discovery entirely. {preset_id} is substituted
# from IIKO_PRESET_ID above.
IIKO_OLAP_ENDPOINT=/api/olap/fetch/7ac4dfd850327a8d89ab49c7000ba4d93a5263ce/grouped-table
IIKO_PRESETS_ENDPOINT=
IIKO_PRESET_RUN_ENDPOINT=

# --- Sync behaviour -------------------------------------------------
# Days of history re-pulled on every incremental sync. iiko allows closed
# checks to be amended for a few days, so a short tail keeps totals honest.
IIKO_TAIL_DAYS=7
# Split long backfills into chunks of this many days per request.
IIKO_CHUNK_DAYS=62
IIKO_TIMEOUT=120
# Set to 0 only if the server uses a self-signed certificate.
IIKO_VERIFY_SSL=1