# --- Report Settings ----------------------------------------------
IIKO_RESTAURANT=Nani
IIKO_PRESET_NAME=Sales intr

# Leave PRESET_ID blank so app.py dynamically fetches available report presets
# or falls back to an explicit OLAP query without sticking to a bad ID.
IIKO_PRESET_ID=

# --- OLAP Request Payload -----------------------------------------
# Leave STORE_IDS blank to query across all accessible venue departments
IIKO_STORE_IDS=

# Set to 1 to enable non-business payment types (complimentary / без оплаты checks)
IIKO_INCLUDE_NON_BUSINESS=1

# Voided transactions
IIKO_INCLUDE_VOID=0

# --- Endpoint Pinning ---------------------------------------------
# Leave blank to allow automatic endpoint discovery
IIKO_OLAP_ENDPOINT=
IIKO_PRESETS_ENDPOINT=
IIKO_PRESET_RUN_ENDPOINT=

# --- Sync Behaviour -----------------------------------------------
IIKO_TAIL_DAYS=7
IIKO_CHUNK_DAYS=62
IIKO_TIMEOUT=120
IIKO_VERIFY_SSL=1

# --- Browser Identity ---------------------------------------------
IIKO_USER_AGENT=
IIKO_REFERER_PATH=
IIKO_ACCEPT_LANGUAGE=