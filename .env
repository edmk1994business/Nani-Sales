# ------------------------------------------------------------------
#  Nani Executive Sales Dashboard — Configuration (.env)
# ------------------------------------------------------------------

# --- Connection -----------------------------------------------------
IIKO_BASE_URL=https://chinatown.iikoweb.ru
IIKO_LOGIN=Edgar
IIKO_PASSWORD=mkrtchyan1994mk
IIKO_API_KEY=da585561389549e1a86dd049281cd638

# --- Report ---------------------------------------------------------
IIKO_RESTAURANT=Nani
IIKO_PRESET_NAME=Sales intr

# Left EMPTY so app.py skips saved presets and goes straight to direct OLAP queries
IIKO_PRESET_ID=

# --- OLAP request payload -------------------------------------------
# Left EMPTY to query across all accessible stores/departments
IIKO_STORE_IDS=

# Set to 1 to pull in complimentary "(без оплаты)" checks
IIKO_INCLUDE_NON_BUSINESS=1

# Voided transactions
IIKO_INCLUDE_VOID=0

# --- Endpoint pinning -----------------------------------------------
IIKO_OLAP_ENDPOINT=
IIKO_PRESETS_ENDPOINT=
IIKO_PRESET_RUN_ENDPOINT=

# Which fields the resto-style fallback requests (channels / product-mix)
IIKO_OLAP_FIELDSET=channels

# --- Sync behaviour -------------------------------------------------
# Historical start date
IIKO_HISTORY_START=2025-05-01

# Days of history re-pulled on incremental sync
IIKO_TAIL_DAYS=7
# Split long backfills into 62-day chunks
IIKO_CHUNK_DAYS=62
IIKO_TIMEOUT=120
IIKO_VERIFY_SSL=1

# --- Browser identity -----------------------------------------------
IIKO_USER_AGENT=
IIKO_REFERER_PATH=
IIKO_ACCEPT_LANGUAGE=